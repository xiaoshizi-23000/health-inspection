# 复制为 .env 或写入系统环境变量；所有项都有默认值，本地不配也能跑。

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# 敏感字段加密种子（生产环境应从 KMS 注入，不落库不进代码）
FERNET_KEY=

# 业务参数
INSPECTION_TOKEN_GRACE_SECONDS=600
INSPECTION_MAX_WORKERS=16
INSPECTION_SLOW_REQUEST_MS=500
INSPECTION_LOG_RETENTION_DAYS=30
